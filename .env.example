# Mẫu biến môi trường — SAO CHÉP thành .env.local rồi điền giá trị.
# File này nằm trong repo PUBLIC: MỌI giá trị ở đây phải để TRỐNG.
# Tuyệt đối không dán API key hay mật khẩu vào file này.
# Thứ tự biến theo đúng design.md §6.1.

# ───────── Bảo vệ ứng dụng (BẮT BUỘC) ─────────
APP_PASSWORD=                      # mật khẩu dùng chung cho nhân viên
SESSION_SECRET=                    # chuỗi ngẫu nhiên >= 32 ký tự
SESSION_TTL_HOURS=                 # mặc định 8; khoảng hợp lệ 1-168

# ───────── LLM: Gemini (đường mặc định) ─────────
LLM_PROVIDER=                      # gemini | openai-compatible | mock   (mặc định: gemini)
GEMINI_API_KEY=                    # lấy ở https://aistudio.google.com/apikey
GEMINI_MODEL=                      # mặc định gemini-3.5-flash (đã đo 2 lần: OK cả 2 lần)
GEMINI_FALLBACK_MODELS=            # ĐỂ TRỐNG có chủ đích — gemini-3.8-flash và
                                   # gemini-flash-latest đã đo 503 CẢ HAI LẦN, thêm vào
                                   # chỉ làm chậm việc báo lỗi (§6.2)
GEMINI_BASE_URL=                   # mặc định https://generativelanguage.googleapis.com/v1beta
GEMINI_THINKING_LEVEL=             # mặc định low; để trống nếu API từ chối tham số này
GEMINI_ALLOW_NONSTREAM_FALLBACK=   # mặc định true: SSE lỗi -> hạ xuống generateContent (§6.2.1)

# ───────── Embedding: Gemini (đường mặc định) ─────────
EMBEDDING_PROVIDER=                # gemini | openai-compatible | mock
                                   # CHỈ provider là do env quyết định ở đường query;
                                   # model và số chiều đọc từ metadata của index.
EMBEDDING_MODEL=                   # mặc định gemini-embedding-001; CHỈ dùng lúc `npm run ingest`
EMBEDDING_DIMENSION=               # mặc định 768; CHỈ dùng lúc ingest
                                   # bị BỎ QUA khi EMBEDDING_PROVIDER=mock (luôn 256)
EMBEDDING_API_KEY=                 # bỏ trống -> dùng lại GEMINI_API_KEY (chỉ khi provider=gemini)
EMBEDDING_BASE_URL=                # bỏ trống -> dùng lại GEMINI_BASE_URL

# ───────── Tuỳ chọn: endpoint tương thích OpenAI ─────────
# Phủ OpenAI, OpenRouter, Groq, DeepSeek, Together, Ollama local.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=                    # OpenAI:     https://api.openai.com/v1
#                                  # OpenRouter: https://openrouter.ai/api/v1
#                                  # Groq:       https://api.groq.com/openai/v1
#                                  # DeepSeek:   https://api.deepseek.com/v1
#                                  # Together:   https://api.together.xyz/v1
#                                  # Ollama:     http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=

# ───────── Truy xuất ─────────
KB_INDEX_PATH=                     # mặc định ./data/kb-index.json
                                   # ĐỪNG đổi ra ngoài ./data/ khi deploy Vercel:
                                   # outputFileTracingIncludes sẽ không đóng gói đúng file
                                   # => INDEX_MISSING. Chỉ đổi khi tự host.
RETRIEVAL_TOP_K=                   # mặc định 6; khoảng hợp lệ 1-20
RETRIEVAL_MIN_COSINE=              # mặc định 0.25; cổng áp lên cosine THUẦN
                                   # bị ghi đè về 0.05 khi EMBEDDING_PROVIDER=mock
RETRIEVAL_MAX_PER_DOC=             # mặc định 2; khoảng hợp lệ 1-5
RETRIEVAL_CONTEXT_TOKEN_BUDGET=    # mặc định 3500; khoảng hợp lệ 500-8000

# ───────── Cắt chunk (chỉ dùng lúc ingest) ─────────
CHUNK_MAX_TOKENS=                  # mặc định 512; khoảng hợp lệ 128-2048
CHUNK_MIN_TOKENS=                  # mặc định 80; phải <= CHUNK_MAX_TOKENS
CHUNK_OVERLAP_TOKENS=              # mặc định 64; phải <= CHUNK_MAX_TOKENS / 2

# ───────── Ngân sách prompt ─────────
HISTORY_TOKEN_BUDGET=              # mặc định 1000; vượt thì bỏ phần tử CŨ NHẤT trước
PROMPT_TOKEN_BUDGET_TOTAL=         # mặc định 6500; khoảng hợp lệ 2500-30000
                                   # kiểm chéo lúc đọc env: CONTEXT + HISTORY + 1000 + 200 + 600
                                   # phải <= tổng này, không thoả thì dùng mặc định

# ───────── Thời gian ─────────
LLM_ATTEMPT_TIMEOUT_MS=            # mặc định 20000; timeout MỖI LẦN THỬ (không phải tổng)
                                   # deadline tổng của /api/chat là hằng 50s trong code
                                   # (lib/util/http.ts), thấp hơn maxDuration=60 của route.

# ───────── Chống lạm dụng ─────────
TRUSTED_PROXY=                     # mặc định true (Vercel/Render/Fly có proxy ghi đè header).
                                   # Đặt false khi tự host KHÔNG có reverse proxy đáng tin:
                                   # khi đó header IP bị bỏ qua hoàn toàn (§13.4).
RATE_LIMIT_LOGIN=                  # mặc định 5/15m (theo IP)
RATE_LIMIT_LOGIN_GLOBAL=           # mặc định 30/15m (backstop toàn ứng dụng, độc lập IP)
RATE_LIMIT_CHAT=                   # mặc định 20/5m
LOG_LEVEL=                         # debug | info | warn | error (mặc định info)
